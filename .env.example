# Copy to .env and edit. All values are optional.
# RAW_DATA_FILE=data/raw/my_real_dataset.csv   # use real data instead of the synthetic generator
# DATABASE_URL=sqlite:///data/fuel_analytics.db  # or postgresql+psycopg2://user:pass@host/db
# RANDOM_SEED=42
# TABLEAU_EMBED_URL=https://public.tableau.com/views/<workbook>/<dashboard>   # leave empty if not published
# TABLEAU_ALLOWED_HOSTS=public.tableau.com,online.tableau.com,tableau.mycompany.com
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=0
